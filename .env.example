SECRET_KEY=your-secure-key
DATABASE_URL=postgres://tcgpuser:secret@db:5432/tcgp
# Optional: enables the Redis cache backend and Redis-backed sessions.
# Leave unset to use locmem cache + DB-backed sessions instead.
REDIS_URL=redis://:changeme@redis-host:6379/1

# Optional: enables "Log in with Authentik" alongside the regular
# username/password login. Leave OIDC_RP_CLIENT_ID unset to disable it
# entirely (e.g. local dev) — username/password login keeps working either way.
# Provider + Application created in Authentik (OAuth2/OpenID Provider, slug
# "tcgptracker"), redirect URI: https://tcgp.freyd.is/oidc/callback/
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
OIDC_OP_AUTHORIZATION_ENDPOINT=https://auth.freyd.is/application/o/authorize/
OIDC_OP_TOKEN_ENDPOINT=https://auth.freyd.is/application/o/token/
OIDC_OP_USER_ENDPOINT=https://auth.freyd.is/application/o/userinfo/
OIDC_OP_JWKS_ENDPOINT=https://auth.freyd.is/application/o/tcgptracker/jwks/
