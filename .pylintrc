[MASTER]
load-plugins=pylint_django
ignore-paths=apps/tracker/migrations

[MESSAGES CONTROL]
disable=
    missing-docstring,
    invalid-name,
    wildcard-import,
    unused-wildcard-import,
    duplicate-code,
    import-outside-toplevel,
    too-many-ancestors,
    unused-argument,
    unused-import,
    too-few-public-methods

[PYLINT_DJANGO]
django-settings-module=tcgptracker.settings.development

[FORMAT]
max-line-length=120

[DESIGN]
max-locals=35
max-statements=60
